# ---- Database ---------------------------------------------------------------
# SQLite for development. Swap for postgresql+psycopg://user:pass@host:5432/localai
DATABASE_URL=sqlite:///./localai.db
# Postgres: postgresql+psycopg://user:pass@host:5432/localai?sslmode=require

# ---- LLM (Gemini primary, Groq fallback) ------------------------------------
# Both optional. With neither key set the app falls back to message templates
# and the last cached insights row - no screen ever breaks.
LLM_PROVIDER_ORDER=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2
# Free-tier friendly: sleep rather than get throttled, and reuse identical prompts.
LLM_RATE_LIMIT_PER_MINUTE=12
LLM_CACHE_HOURS=24
LLM_BATCH_SIZE=20

# ---- Delivery ---------------------------------------------------------------
# console logs messages instead of sending them (the safe default).
# twilio_wa uses the Twilio WhatsApp sandbox; whatsapp_cloud uses Meta's Cloud API.
# Sending is always an explicit action on a chosen set - never on a schedule.
DELIVERY_ADAPTER=console
DELIVERY_DAILY_CAP=50
DELIVERY_RATE_LIMIT_PER_MINUTE=10

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Auth -------------------------------------------------------------------
# Enforced in the API for every request, not just hidden in the UI.
# Generate a real secret for anything deployed: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ENABLED=true
JWT_SECRET=change-me-in-env-this-is-not-a-secret
JWT_EXPIRY_MINUTES=720

# ---- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=2
SCHEDULER_MINUTE=0

# ---- Frontend ---------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000

# ---- Observability and backups ----------------------------------------------
JSON_LOGS=false
LOG_LEVEL=INFO
BACKUP_DIR=backups
BACKUP_KEEP=14
# Optional object storage for the nightly dump.
BACKUP_S3_BUCKET=
