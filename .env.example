# ---- Database ---------------------------------------------------------------
# SQLite for development. Swap for postgresql+psycopg://user:pass@host:5432/localai
DATABASE_URL=sqlite:///./localai.db

# ---- LLM (Groq primary, Gemini fallback) ------------------------------------
# Both optional. With neither key set the app falls back to message templates
# and the last cached insights row - no screen ever breaks.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=2

# ---- Delivery ---------------------------------------------------------------
# console marks reminders sent and logs them. twilio_wa sends one real message.
DELIVERY_ADAPTER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ---- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=2
SCHEDULER_MINUTE=0

# ---- Frontend ---------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
